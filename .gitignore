# Secrets / local contact info — never commit. Contact lives in the shell env.
.env
.env.*

# Raw fetched responses — provenance cache, not source. Regenerable, can get large.
data/cache/

# The SQLite store — derived from cache + parsers, regenerable.
data/*.db
data/*.db-wal
data/*.db-shm

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# OS
.DS_Store
